# Скопируйте в .env рядом с этим каталогом (`backend/.env`).
# Сервер загружает ближайший .env, поднимаясь от текущего рабочего каталога к корню,
# или используйте файл в корне монорепозитория (например `kursovaya/.env`).

# Ключ OpenAI для POST /api/chat/tutor (чат репетитора).
OPENAI_API_KEY=

# Песочница Go: без Docker на локальной машине задайте local.
SANDBOX_MODE=local

# Если SANDBOX_MODE не local — образ для docker run из internal/sandbox/runner.go.
SANDBOX_IMAGE=go-llm-sandbox:latest

# Порт HTTP (пусто = :8080).
PORT=8080

# Абсолютный или относительный путь к каталогу с course_manifest.json и module_*.json.
# По умолчанию ищется `data/lessons` внутри backend.
COURSE_DATA_DIR=

# PostgreSQL (профиль и прогресс). При недоступности БД API /api/users/* не регистрируется.
DATABASE_URL=postgres://golandia:golandia@localhost:5432/golandia?sslmode=disable
